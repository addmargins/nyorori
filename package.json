{
  "name": "nyorori",
  "version": "0.0.0",
  "description": "Diff-scoped mutation testing for Vitest: fail the PR when changed code has surviving mutants",
  "license": "MIT",
  "type": "module",
  "bin": {
    "nyorori": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "magic-string": "^1.4.3",
    "oxc-minify": "0.155.0",
    "oxc-parser": "0.155.0",
    "oxc-transform": "0.155.0",
    "oxc-walker": "1.1.1",
    "picomatch": "^4.0.7",
    "typescript": "7.1.0-beta"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "happy-dom": "20.9.0",
    "vitest": "^5.0.5"
  }
}
